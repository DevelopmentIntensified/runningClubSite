# Copy to ".env" and replace with real values. Required for `vite build` (SvelteKit inlines $env/static/private at build time).

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/runningclub

RESENDAPIKEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
DOMAIN=example.com
EMAILSECRET=change_me_to_a_long_random_string_for_jwt
CLUBEMAIL=libertyrunningclub@libertyrunningclub.com
# Inbox that receives forwarded emails and contact-form submissions (club's own mailbox)
CLUB_INBOX_EMAIL=libertyrunningclub@libertyrunningclub.com

# Vercel Blob (admin image uploads)
BLOB_READ_WRITE_TOKEN=
