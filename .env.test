# Local test environment: used by `npm run dev:test`, `db:push:test` and the
# Playwright suite. Points at the local docker Postgres (docker-compose.yml).
# See .env.example for the full set of required values.

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/runningclub

# Emails must never be sent from local tests; these are dummy values so the
# app boots. Auth flows in tests insert code rows directly instead of emailing.
RESENDAPIKEY=re_dummy_local_key_no_emails
RESEND_API_KEY=re_dummy_local_key_no_emails
RESEND_WEBHOOK_SECRET=
DOMAIN=localhost
EMAILSECRET=local_test_secret_change_me_long_random_string
CLUBEMAIL=libertyrunningclub@libertyrunningclub.com
CLUB_INBOX_EMAIL=libertyrunningclub71@gmail.com

# Vercel Blob (admin image uploads) — not available locally
BLOB_READ_WRITE_TOKEN=
